rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Set Firebase custom claims role to unit_admin or central_admin only after verifying staff identity.
    function canReview() {
      return signedIn() && request.auth.token.role in ['unit_admin', 'central_admin'];
    }

    match /teachingRecords/{recordId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['date','school','lesson','students','note','status','ownerUid','ownerEmail','updatedAt','submittedAt','reviewStatus'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.school is string && request.resource.data.school.size() > 0 && request.resource.data.school.size() <= 200
        && request.resource.data.lesson is string && request.resource.data.lesson.size() <= 300
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 2000))
        && request.resource.data.students is int
        && request.resource.data.students >= 0 && request.resource.data.students <= 10000
        && request.resource.data.status in ['draft','submitted']
        && (request.resource.data.status == 'draft' || request.resource.data.reviewStatus == 'pending');

      // Teachers can read their own records. Reviewers can read only submitted records still awaiting review.
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (canReview() && resource.data.status == 'submitted' && resource.data.reviewStatus == 'pending')
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'draft';

      // Owner edits are limited to their own teaching content and cannot modify review decisions.
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date','school','lesson','students','note','status','updatedAt','submittedAt','reviewStatus'])
        && request.resource.data.status in ['draft','submitted']
        && (!('reviewStatus' in resource.data) || resource.data.reviewStatus in ['pending','revision_requested'])
        && request.resource.data.students is int && request.resource.data.students >= 0 && request.resource.data.students <= 10000
        && request.resource.data.school is string && request.resource.data.school.size() > 0 && request.resource.data.school.size() <= 200
        && request.resource.data.lesson is string && request.resource.data.lesson.size() <= 300
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 2000))
        && (
          (request.resource.data.status == 'submitted' && request.resource.data.reviewStatus == 'pending') ||
          (request.resource.data.status == 'draft' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewStatus']))
        );

      // Only trusted reviewer accounts with a verified custom claim may approve or return a report.
      allow update: if canReview()
        && resource.data.status == 'submitted'
        && resource.data.reviewStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus','reviewComment','reviewedBy','reviewedAt','updatedAt'])
        && request.resource.data.reviewStatus in ['approved','revision_requested']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewComment is string;
    }

    // Deny access to all collections not explicitly configured above.
    match /{document=**} { allow read, write: if false; }
  }
}
